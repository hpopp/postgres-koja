test "a zero limit disables the cache"
  assert not StatementCache.new(0).enabled?()
end

test "the key covers SQL text and parameter OIDs"
  assert StatementCache.key("SELECT $1", [23, 25]) == "SELECT $1|23|25"

  no_params: List<Int> = List.new()

  assert StatementCache.key("SELECT 1", no_params) == "SELECT 1"
end

test "hit misses on an empty cache and finds a stored name"
  cache = StatementCache.new(4)
  (cache, missed) = cache.hit("k")

  assert missed == Option.None

  cache = cache.store("k", "koja_s1")
  (_, found) = cache.hit("k")

  assert found == Option.Some("koja_s1")
end

test "reserve claims sequential statement names"
  cache = StatementCache.new(4)
  (cache, first, _) = cache.reserve()
  (_, second, _) = cache.reserve()

  assert first == "koja_s1"
  assert second == "koja_s2"
end

test "a full cache evicts the least recently used entry"
  cache = StatementCache.new(2)
  cache = cache.store("a", "koja_s1")
  cache = cache.store("b", "koja_s2")

  # Touch `a` so `b` becomes the least recently used entry.
  (cache, _) = cache.hit("a")
  (cache, _, close_frame) = cache.reserve()

  assert close_frame == Message.encode_close("koja_s2")

  (cache, kept) = cache.hit("a")
  assert kept.some?(), "expected `a` to survive eviction"

  (_, evicted) = cache.hit("b")
  assert evicted.none?(), "expected `b` to be evicted"
end

test "remove drops an entry"
  cache = StatementCache.new(4)
  cache = cache.store("k", "koja_s1")
  (_, found) = cache.remove("k").hit("k")

  assert found.none?()
end
