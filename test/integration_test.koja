# Integration tests against a live Postgres server. Start it first:
#
# docker compose up -d
#
priv const TEST_DATABASE: String = "koja_test"
priv const TEST_HOST: String = "127.0.0.1"
priv const TEST_PORT: Int = 5434

struct IntegrationTest
  @test "connects with trust auth and runs SELECT"
  fn test_trust_select -> Result<Bool, String>
    conn =
      match IntegrationTest.connect_trust()
        Result.Ok(c) -> c
        Result.Err(e) -> return Result.Err(e)
      end

    (conn, outcome) = conn.query("SELECT 1 AS one, 'two' AS two")
    _ = conn.close()

    result =
      match outcome
        Result.Ok(r) -> r
        Result.Err(e) -> return Result.Err(e.message())
      end

    unless result.tag == "SELECT 1"
      return Result.Err("expected tag `SELECT 1`, got `#{result.tag}`")
    end

    unless result.fields.length() == 2
      return Result.Err("expected 2 fields, got #{result.fields.length()}")
    end

    unless IntegrationTest.cell(result, 0, 0) == Value.Int(1)
      return Result.Err("expected Int(1) at (0,0)")
    end

    IntegrationTest.cell(result, 0, 1) == Value.String("two")
      ? Result.Ok(true)
      : Result.Err("expected String(two) at (0,1)")
  end

  @test "returns NULL columns as None"
  fn test_null_column -> Result<Bool, String>
    conn =
      match IntegrationTest.connect_trust()
        Result.Ok(c) -> c
        Result.Err(e) -> return Result.Err(e)
      end

    (conn, outcome) = conn.query("SELECT NULL AS nothing")
    _ = conn.close()

    result =
      match outcome
        Result.Ok(r) -> r
        Result.Err(e) -> return Result.Err(e.message())
      end

    match IntegrationTest.cell(result, 0, 0)
      Value.Null -> Result.Ok(true)
      other -> Result.Err("expected Null, got #{other.format()}")
    end
  end

  @test "decodes bool, int, float, text, and NULL to typed values"
  fn test_typed_round_trip -> Result<Bool, String>
    conn =
      match IntegrationTest.connect_trust()
        Result.Ok(c) -> c
        Result.Err(e) -> return Result.Err(e)
      end

    (conn, outcome) = conn.query("SELECT true, 42, 1.5::float8, 'hi', NULL")
    _ = conn.close()

    result =
      match outcome
        Result.Ok(r) -> r
        Result.Err(e) -> return Result.Err(e.message())
      end

    expected: List<Value> = [
      Value.Bool(true), Value.Int(42), Value.Float(1.5), Value.String("hi"),
      Value.Null
    ]

    index = 0

    for want in expected
      got = IntegrationTest.cell(result, 0, index)

      unless got == want
        return Result.Err("column #{index} decoded to #{got.format()}, want #{want.format()}")
      end

      index = index + 1
    end

    Result.Ok(true)
  end

  @test "runs DDL and DML with the right command tags"
  fn test_ddl_and_dml_tags -> Result<Bool, String>
    conn =
      match IntegrationTest.connect_trust()
        Result.Ok(c) -> c
        Result.Err(e) -> return Result.Err(e)
      end

    (conn, created) = conn.query(
      "CREATE TEMP TABLE driver_test (id INT, label TEXT)",
    )

    match IntegrationTest.expect_tag(created, "CREATE TABLE")
      Result.Err(e) ->
        _ = conn.close()
        return Result.Err(e)

      Result.Ok(_) ->
        ()
    end

    (conn, inserted) = conn.query(
      "INSERT INTO driver_test VALUES (7, 'seven'), (8, NULL)",
    )

    match IntegrationTest.expect_tag(inserted, "INSERT 0 2")
      Result.Err(e) ->
        _ = conn.close()
        return Result.Err(e)

      Result.Ok(_) ->
        ()
    end

    (conn, selected) = conn.query("SELECT label FROM driver_test ORDER BY id")
    _ = conn.close()

    result =
      match selected
        Result.Ok(r) -> r
        Result.Err(e) -> return Result.Err(e.message())
      end

    unless result.rows.length() == 2
      return Result.Err("expected 2 rows, got #{result.rows.length()}")
    end

    unless IntegrationTest.cell(result, 0, 0) == Value.String("seven")
      return Result.Err("expected String(seven) in row 0")
    end

    match IntegrationTest.cell(result, 1, 0)
      Value.Null -> Result.Ok(true)
      other -> Result.Err("expected Null, got #{other.format()}")
    end
  end

  @test "surfaces server errors with severity and SQLSTATE"
  fn test_server_error -> Result<Bool, String>
    conn =
      match IntegrationTest.connect_trust()
        Result.Ok(c) -> c
        Result.Err(e) -> return Result.Err(e)
      end

    (conn, outcome) = conn.query("SELEC 1")
    _ = conn.close()

    match outcome
      Result.Ok(_) ->
        Result.Err("expected a syntax error, got a result")

      Result.Err(Error.Server(server_error)) ->
        unless server_error.code == "42601"
          return Result.Err("expected SQLSTATE 42601, got #{server_error.code}")
        end

        server_error.severity == "ERROR"
          ? Result.Ok(true)
          : Result.Err("expected severity ERROR, got #{server_error.severity}")

      Result.Err(e) ->
        Result.Err("expected Error.Server, got: " <> e.message())
    end
  end

  @test "connects with a cleartext password"
  fn test_cleartext_auth -> Result<Bool, String>
    config = Config.new(TEST_HOST, TEST_PORT, "koja_password", TEST_DATABASE)
      .with_password("koja_password_secret")

    IntegrationTest.connect_and_select_user(config, "koja_password")
  end

  @test "connects with SCRAM-SHA-256"
  fn test_scram_auth -> Result<Bool, String>
    config = Config.new(TEST_HOST, TEST_PORT, "koja_scram", TEST_DATABASE)
      .with_password("koja_scram_secret")

    IntegrationTest.connect_and_select_user(config, "koja_scram")
  end

  @test "rejects a wrong SCRAM password"
  fn test_scram_wrong_password -> Result<Bool, String>
    config = Config.new(TEST_HOST, TEST_PORT, "koja_scram", TEST_DATABASE)
      .with_password("wrong")

    match Connection.connect(config)
      Result.Ok(conn) ->
        _ = conn.close()
        Result.Err("expected authentication to fail")

      Result.Err(Error.Server(server_error)) ->
        server_error.code == "28P01"
          ? Result.Ok(true)
          : Result.Err("expected SQLSTATE 28P01, got #{server_error.code}")

      Result.Err(e) ->
        Result.Err("expected a server error, got: " <> e.message())
    end
  end

  @test "fails clearly when a password is needed but missing"
  fn test_missing_password -> Result<Bool, String>
    config = Config.new(TEST_HOST, TEST_PORT, "koja_scram", TEST_DATABASE)

    match Connection.connect(config)
      Result.Ok(conn) ->
        _ = conn.close()
        Result.Err("expected connect to fail without a password")

      Result.Err(Error.AuthenticationFailed(_)) ->
        Result.Ok(true)

      Result.Err(e) ->
        Result.Err("expected AuthenticationFailed, got: " <> e.message())
    end
  end

  @test "executes a typed parameterized SELECT without casts"
  fn test_execute_select -> Result<Bool, String>
    conn =
      match IntegrationTest.connect_trust()
        Result.Ok(c) -> c
        Result.Err(e) -> return Result.Err(e)
      end

    # Declared parameter OIDs type $1 and $2 as int8, so the SQL
    # needs no ::int casts.
    params = [Value.int(40), Value.int(2)]
    (conn, outcome) = conn.execute("SELECT $1 + $2 AS total", params)
    _ = conn.close()

    result =
      match outcome
        Result.Ok(r) -> r
        Result.Err(e) -> return Result.Err(e.message())
      end

    unless result.tag == "SELECT 1"
      return Result.Err("expected tag `SELECT 1`, got `#{result.tag}`")
    end

    IntegrationTest.cell(result, 0, 0) == Value.Int(42)
      ? Result.Ok(true)
      : Result.Err("expected Int(42) total")
  end

  @test "executes DML with NULL parameters and reads them back"
  fn test_execute_null_param -> Result<Bool, String>
    conn =
      match IntegrationTest.connect_trust()
        Result.Ok(c) -> c
        Result.Err(e) -> return Result.Err(e)
      end

    (conn, created) = conn.execute(
      "CREATE TEMP TABLE exec_test (id INT, label TEXT)",
    )

    match IntegrationTest.expect_tag(created, "CREATE TABLE")
      Result.Err(e) ->
        _ = conn.close()
        return Result.Err(e)

      Result.Ok(_) ->
        ()
    end

    insert_params = [Value.int(1), Value.null()]
    (conn, inserted) = conn.execute(
      "INSERT INTO exec_test VALUES ($1, $2)",
      insert_params,
    )

    match IntegrationTest.expect_tag(inserted, "INSERT 0 1")
      Result.Err(e) ->
        _ = conn.close()
        return Result.Err(e)

      Result.Ok(_) ->
        ()
    end

    select_params = [Value.int(1)]
    (conn, selected) = conn.execute(
      "SELECT label FROM exec_test WHERE id = $1",
      select_params,
    )
    _ = conn.close()

    result =
      match selected
        Result.Ok(r) -> r
        Result.Err(e) -> return Result.Err(e.message())
      end

    unless result.rows.length() == 1
      return Result.Err("expected 1 row, got #{result.rows.length()}")
    end

    match IntegrationTest.cell(result, 0, 0)
      Value.Null -> Result.Ok(true)
      other -> Result.Err("expected Null label, got #{other.format()}")
    end
  end

  @test "surfaces server errors from execute"
  fn test_execute_server_error -> Result<Bool, String>
    conn =
      match IntegrationTest.connect_trust()
        Result.Ok(c) -> c
        Result.Err(e) -> return Result.Err(e)
      end

    (conn, outcome) = conn.execute("SELECT * FROM missing_table")
    _ = conn.close()

    match outcome
      Result.Ok(_) ->
        Result.Err("expected an error for a missing table")

      Result.Err(Error.Server(server_error)) ->
        server_error.code == "42P01"
          ? Result.Ok(true)
          : Result.Err("expected SQLSTATE 42P01, got #{server_error.code}")

      Result.Err(e) ->
        Result.Err("expected Error.Server, got: " <> e.message())
    end
  end

  @test "execute reuses a cached prepared statement"
  fn test_statement_cache_reuse -> Result<Bool, String>
    conn =
      match IntegrationTest.connect_trust()
        Result.Ok(c) -> c
        Result.Err(e) -> return Result.Err(e)
      end

    first_params = [Value.int(1)]
    (conn, first) = conn.execute("SELECT $1 AS n", first_params)

    match first
      Result.Ok(_) ->
        ()

      Result.Err(e) ->
        _ = conn.close()
        return Result.Err(e.message())
    end

    second_params = [Value.int(2)]
    (conn, second) = conn.execute("SELECT $1 AS n", second_params)

    result =
      match second
        Result.Ok(r) ->
          r

        Result.Err(e) ->
          _ = conn.close()
          return Result.Err(e.message())
      end

    unless IntegrationTest.cell(result, 0, 0) == Value.Int(2)
      _ = conn.close()
      return Result.Err("expected Int(2) from the cached statement")
    end

    (conn, names) = IntegrationTest.prepared_names(conn)
    _ = conn.close()

    listed =
      match names
        Result.Ok(r) -> r
        Result.Err(e) -> return Result.Err(e)
      end

    unless listed.rows.length() == 1
      return Result.Err("expected 1 prepared statement, got #{listed.rows.length()}")
    end

    IntegrationTest.cell(listed, 0, 0) == Value.String("koja_s1")
      ? Result.Ok(true)
      : Result.Err("expected statement koja_s1")
  end

  @test "the cache evicts the least recently used statement"
  fn test_statement_cache_eviction -> Result<Bool, String>
    config = Config.new(TEST_HOST, TEST_PORT, "koja_trust", TEST_DATABASE)
      .with_statement_cache_size(1)

    conn =
      match IntegrationTest.connect_config(config)
        Result.Ok(c) -> c
        Result.Err(e) -> return Result.Err(e)
      end

    (conn, first) = conn.execute("SELECT 1 AS a")

    match first
      Result.Ok(_) ->
        ()

      Result.Err(e) ->
        _ = conn.close()
        return Result.Err(e.message())
    end

    (conn, second) = conn.execute("SELECT 2 AS b")

    match second
      Result.Ok(_) ->
        ()

      Result.Err(e) ->
        _ = conn.close()
        return Result.Err(e.message())
    end

    (conn, names) = IntegrationTest.prepared_names(conn)
    _ = conn.close()

    listed =
      match names
        Result.Ok(r) -> r
        Result.Err(e) -> return Result.Err(e)
      end

    unless listed.rows.length() == 1
      return Result.Err("expected the first statement to be closed, " <>
        "got #{listed.rows.length()} prepared")
    end

    IntegrationTest.cell(listed, 0, 0) == Value.String("koja_s2")
      ? Result.Ok(true)
      : Result.Err("expected only koja_s2 to remain")
  end

  @test "a zero cache size prepares nothing"
  fn test_statement_cache_disabled -> Result<Bool, String>
    config = Config.new(TEST_HOST, TEST_PORT, "koja_trust", TEST_DATABASE)
      .with_statement_cache_size(0)

    conn =
      match IntegrationTest.connect_config(config)
        Result.Ok(c) -> c
        Result.Err(e) -> return Result.Err(e)
      end

    params = [Value.int(7)]
    (conn, outcome) = conn.execute("SELECT $1 AS n", params)

    result =
      match outcome
        Result.Ok(r) ->
          r

        Result.Err(e) ->
          _ = conn.close()
          return Result.Err(e.message())
      end

    unless IntegrationTest.cell(result, 0, 0) == Value.Int(7)
      _ = conn.close()
      return Result.Err("expected Int(7) from the uncached statement")
    end

    (conn, names) = IntegrationTest.prepared_names(conn)
    _ = conn.close()

    listed =
      match names
        Result.Ok(r) -> r
        Result.Err(e) -> return Result.Err(e)
      end

    listed.rows.length() == 0
      ? Result.Ok(true)
      : Result.Err("expected no prepared statements, got #{listed.rows.length()}")
  end

  @test "a schema change under a cached statement re-prepares"
  fn test_stale_statement_schema_change -> Result<Bool, String>
    conn =
      match IntegrationTest.connect_trust()
        Result.Ok(c) -> c
        Result.Err(e) -> return Result.Err(e)
      end

    setup = [
      "DROP TABLE IF EXISTS stale_plan_probe",
      "CREATE TABLE stale_plan_probe (a int)",
      "INSERT INTO stale_plan_probe (a) VALUES (1)"
    ]

    for sql in setup
      (next, outcome) = conn.query(sql)
      conn = next

      match outcome
        Result.Ok(_) ->
          ()

        Result.Err(e) ->
          _ = conn.close()
          return Result.Err(e.message())
      end
    end

    (conn, first) = conn.execute("SELECT * FROM stale_plan_probe")

    match first
      Result.Ok(_) ->
        ()

      Result.Err(e) ->
        _ = conn.close()
        return Result.Err(e.message())
    end

    # Adding a column changes the result shape of `SELECT *`, which
    # invalidates the cached plan (SQLSTATE 0A000) on the next run.
    (conn, altered) = conn.query(
      "ALTER TABLE stale_plan_probe ADD COLUMN b int",
    )

    match altered
      Result.Ok(_) ->
        ()

      Result.Err(e) ->
        _ = conn.close()
        return Result.Err(e.message())
    end

    (conn, second) = conn.execute("SELECT * FROM stale_plan_probe")
    (conn, _) = conn.query("DROP TABLE stale_plan_probe")
    _ = conn.close()

    result =
      match second
        Result.Ok(r) -> r
        Result.Err(e) ->
          return Result.Err("expected a re-prepare after the schema change, got: " <>
            e.message())
      end

    result.fields.length() == 2
      ? Result.Ok(true)
      : Result.Err("expected 2 columns after re-prepare, got #{result.fields.length()}")
  end

  @test "a deallocated statement re-prepares"
  fn test_stale_statement_deallocated -> Result<Bool, String>
    conn =
      match IntegrationTest.connect_trust()
        Result.Ok(c) -> c
        Result.Err(e) -> return Result.Err(e)
      end

    first_params = [Value.int(1)]
    (conn, first) = conn.execute("SELECT $1 AS n", first_params)

    match first
      Result.Ok(_) ->
        ()

      Result.Err(e) ->
        _ = conn.close()
        return Result.Err(e.message())
    end

    # DEALLOCATE ALL drops every prepared statement server-side, like
    # a pooler running DISCARD ALL between checkouts.
    (conn, dropped) = conn.query("DEALLOCATE ALL")

    match dropped
      Result.Ok(_) ->
        ()

      Result.Err(e) ->
        _ = conn.close()
        return Result.Err(e.message())
    end

    second_params = [Value.int(9)]
    (conn, second) = conn.execute("SELECT $1 AS n", second_params)
    (conn, names) = IntegrationTest.prepared_names(conn)
    _ = conn.close()

    result =
      match second
        Result.Ok(r) -> r
        Result.Err(e) ->
          return Result.Err("expected a re-prepare after DEALLOCATE ALL, got: " <>
            e.message())
      end

    unless IntegrationTest.cell(result, 0, 0) == Value.Int(9)
      return Result.Err("expected Int(9) from the re-prepared statement")
    end

    listed =
      match names
        Result.Ok(r) -> r
        Result.Err(e) -> return Result.Err(e)
      end

    listed.rows.length() == 1
      ? Result.Ok(true)
      : Result.Err("expected 1 re-prepared statement, got #{listed.rows.length()}")
  end

  priv fn connect_and_select_user(config: Config, want_user: String)
    -> Result<Bool, String>

    conn =
      match Connection.connect(config)
        Result.Ok(c) -> c
        Result.Err(e) ->
          return Result.Err("connect failed (is docker compose up?): " <>
            e.message())
      end

    (conn, outcome) = conn.query("SELECT current_user")
    _ = conn.close()

    result =
      match outcome
        Result.Ok(r) -> r
        Result.Err(e) -> return Result.Err(e.message())
      end

    IntegrationTest.cell(result, 0, 0) == Value.String(want_user)
      ? Result.Ok(true)
      : Result.Err("expected current_user `#{want_user}`")
  end

  priv fn connect_trust -> Result<Connection, String>
    IntegrationTest.connect_config(
      Config.new(TEST_HOST, TEST_PORT, "koja_trust", TEST_DATABASE),
    )
  end

  priv fn connect_config(config: Config) -> Result<Connection, String>
    match Connection.connect(config)
      Result.Ok(conn) ->
        Result.Ok(conn)

      Result.Err(e) ->
        Result.Err("connect failed (is docker compose up?): " <> e.message())
    end
  end

  # The typed value at a row and column, or `Null` when out of range.
  priv fn cell(result: QueryResult, row: Int, column: Int) -> Value
    match result.rows.get(row)
      Option.Some(columns) ->
        match columns.get(column)
          Option.Some(value) -> value
          Option.None -> Value.Null
        end

      Option.None ->
        Value.Null
    end
  end

  # The statement names the server currently holds, for cache
  # assertions. Uses the simple protocol, which the cache ignores.
  priv fn prepared_names(conn: Connection)
    -> (Connection, Result<QueryResult, String>)

    (conn, outcome) = conn.query(
      "SELECT name FROM pg_prepared_statements ORDER BY name",
    )

    match outcome
      Result.Ok(result) -> (conn, Result.Ok(result))
      Result.Err(e) -> (conn, Result.Err(e.message()))
    end
  end

  priv fn expect_tag(outcome: Result<QueryResult, Error>, want: String)
    -> Result<Bool, String>

    match outcome
      Result.Ok(result) ->
        result.tag == want
          ? Result.Ok(true)
          : Result.Err("expected tag `#{want}`, got `#{result.tag}`")

      Result.Err(e) ->
        Result.Err(e.message())
    end
  end
end
