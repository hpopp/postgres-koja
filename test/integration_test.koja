# Integration tests against a live Postgres server. Start it first:
#
# docker compose up -d
#
priv const TEST_DATABASE: String = "koja_test"
priv const TEST_HOST: String = "127.0.0.1"
priv const TEST_PORT: Int = 5434

struct IntegrationTest
  test "connects with trust auth and runs SELECT"
    conn = try IntegrationTest.connect_trust()

    (conn, outcome) = conn.query("SELECT 1 AS one, 'two' AS two")
    _ = conn.close()

    result = try IntegrationTest.unwrap(outcome)

    assert result.tag == "SELECT 1"
    assert result.fields.length() == 2
    assert IntegrationTest.cell(result, 0, 0) == Value.Int(1)
    assert IntegrationTest.cell(result, 0, 1) == Value.String("two")
  end

  test "returns NULL columns as None"
    conn = try IntegrationTest.connect_trust()

    (conn, outcome) = conn.query("SELECT NULL AS nothing")
    _ = conn.close()

    result = try IntegrationTest.unwrap(outcome)

    assert IntegrationTest.cell(result, 0, 0) == Value.Null
  end

  test "decodes bool, int, float, text, and NULL to typed values"
    conn = try IntegrationTest.connect_trust()

    (conn, outcome) = conn.query("SELECT true, 42, 1.5::float8, 'hi', NULL")
    _ = conn.close()

    result = try IntegrationTest.unwrap(outcome)

    expected: List<Value> = [
      Value.Bool(true), Value.Int(42), Value.Float(1.5), Value.String("hi"),
      Value.Null
    ]

    index = 0

    for want in expected
      assert IntegrationTest.cell(result, 0, index) == want, "column #{index}"

      index = index + 1
    end
  end

  test "runs DDL and DML with the right command tags"
    conn = try IntegrationTest.connect_trust()

    (conn, created) = conn.query(
      "CREATE TEMP TABLE driver_test (id INT, label TEXT)",
    )
    try IntegrationTest.expect_tag(created, "CREATE TABLE")

    (conn, inserted) = conn.query(
      "INSERT INTO driver_test VALUES (7, 'seven'), (8, NULL)",
    )
    try IntegrationTest.expect_tag(inserted, "INSERT 0 2")

    (conn, selected) = conn.query("SELECT label FROM driver_test ORDER BY id")
    _ = conn.close()

    result = try IntegrationTest.unwrap(selected)

    assert result.rows.length() == 2
    assert IntegrationTest.cell(result, 0, 0) == Value.String("seven")
    assert IntegrationTest.cell(result, 1, 0) == Value.Null
  end

  test "surfaces server errors with severity and SQLSTATE"
    conn = try IntegrationTest.connect_trust()

    (conn, outcome) = conn.query("SELEC 1")
    _ = conn.close()

    match outcome
      Result.Ok(_) ->
        fail "expected a syntax error, got a result"

      Result.Err(Error.Server(server_error)) ->
        assert server_error.code == "42601"
        assert server_error.severity == "ERROR"

      Result.Err(e) ->
        fail "expected Error.Server, got: #{e.message()}"
    end
  end

  test "connects with a cleartext password"
    config = Config.new(TEST_HOST, TEST_PORT, "koja_password", TEST_DATABASE)
      .with_password("koja_password_secret")

    try IntegrationTest.connect_and_select_user(config, "koja_password")
  end

  test "connects with SCRAM-SHA-256"
    config = Config.new(TEST_HOST, TEST_PORT, "koja_scram", TEST_DATABASE)
      .with_password("koja_scram_secret")

    try IntegrationTest.connect_and_select_user(config, "koja_scram")
  end

  test "rejects a wrong SCRAM password"
    config = Config.new(TEST_HOST, TEST_PORT, "koja_scram", TEST_DATABASE)
      .with_password("wrong")

    match Connection.connect(config)
      Result.Ok(conn) ->
        _ = conn.close()
        fail "expected authentication to fail"

      Result.Err(Error.Server(server_error)) ->
        assert server_error.code == "28P01"

      Result.Err(e) ->
        fail "expected a server error, got: #{e.message()}"
    end
  end

  test "fails clearly when a password is needed but missing"
    config = Config.new(TEST_HOST, TEST_PORT, "koja_scram", TEST_DATABASE)

    match Connection.connect(config)
      Result.Ok(conn) ->
        _ = conn.close()
        fail "expected connect to fail without a password"

      Result.Err(Error.AuthenticationFailed(_)) ->
        ()

      Result.Err(e) ->
        fail "expected AuthenticationFailed, got: #{e.message()}"
    end
  end

  test "executes a typed parameterized SELECT without casts"
    conn = try IntegrationTest.connect_trust()

    # Declared parameter OIDs type $1 and $2 as int8, so the SQL
    # needs no ::int casts.
    params = [Value.int(40), Value.int(2)]
    (conn, outcome) = conn.execute("SELECT $1 + $2 AS total", params)
    _ = conn.close()

    result = try IntegrationTest.unwrap(outcome)

    assert result.tag == "SELECT 1"
    assert IntegrationTest.cell(result, 0, 0) == Value.Int(42)
  end

  test "executes DML with NULL parameters and reads them back"
    conn = try IntegrationTest.connect_trust()

    (conn, created) = conn.execute(
      "CREATE TEMP TABLE exec_test (id INT, label TEXT)",
    )
    try IntegrationTest.expect_tag(created, "CREATE TABLE")

    insert_params = [Value.int(1), Value.null()]
    (conn, inserted) = conn.execute(
      "INSERT INTO exec_test VALUES ($1, $2)",
      insert_params,
    )
    try IntegrationTest.expect_tag(inserted, "INSERT 0 1")

    select_params = [Value.int(1)]
    (conn, selected) = conn.execute(
      "SELECT label FROM exec_test WHERE id = $1",
      select_params,
    )
    _ = conn.close()

    result = try IntegrationTest.unwrap(selected)

    assert result.rows.length() == 1
    assert IntegrationTest.cell(result, 0, 0) == Value.Null
  end

  test "surfaces server errors from execute"
    conn = try IntegrationTest.connect_trust()

    (conn, outcome) = conn.execute("SELECT * FROM missing_table")
    _ = conn.close()

    match outcome
      Result.Ok(_) -> fail "expected an error for a missing table"
      Result.Err(Error.Server(server_error)) ->
        assert server_error.code == "42P01"
      Result.Err(e) -> fail "expected Error.Server, got: #{e.message()}"
    end
  end

  test "execute reuses a cached prepared statement"
    conn = try IntegrationTest.connect_trust()

    first_params = [Value.int(1)]
    (conn, first) = conn.execute("SELECT $1 AS n", first_params)
    try IntegrationTest.unwrap(first)

    second_params = [Value.int(2)]
    (conn, second) = conn.execute("SELECT $1 AS n", second_params)
    result = try IntegrationTest.unwrap(second)

    assert IntegrationTest.cell(result, 0, 0) == Value.Int(2)

    (conn, names) = IntegrationTest.prepared_names(conn)
    _ = conn.close()

    listed = try IntegrationTest.unwrap(names)

    assert listed.rows.length() == 1
    assert IntegrationTest.cell(listed, 0, 0) == Value.String("koja_s1")
  end

  test "the cache evicts the least recently used statement"
    config = Config.new(TEST_HOST, TEST_PORT, "koja_trust", TEST_DATABASE)
      .with_statement_cache_size(1)

    conn = try IntegrationTest.connect_config(config)

    (conn, first) = conn.execute("SELECT 1 AS a")
    try IntegrationTest.unwrap(first)

    (conn, second) = conn.execute("SELECT 2 AS b")
    try IntegrationTest.unwrap(second)

    (conn, names) = IntegrationTest.prepared_names(conn)
    _ = conn.close()

    listed = try IntegrationTest.unwrap(names)

    assert listed.rows.length() == 1, "expected the first statement to be closed"
    assert IntegrationTest.cell(listed, 0, 0) == Value.String("koja_s2")
  end

  test "a zero cache size prepares nothing"
    config = Config.new(TEST_HOST, TEST_PORT, "koja_trust", TEST_DATABASE)
      .with_statement_cache_size(0)

    conn = try IntegrationTest.connect_config(config)

    params = [Value.int(7)]
    (conn, outcome) = conn.execute("SELECT $1 AS n", params)
    result = try IntegrationTest.unwrap(outcome)

    assert IntegrationTest.cell(result, 0, 0) == Value.Int(7)

    (conn, names) = IntegrationTest.prepared_names(conn)
    _ = conn.close()

    listed = try IntegrationTest.unwrap(names)

    assert listed.rows.length() == 0
  end

  test "a schema change under a cached statement re-prepares"
    conn = try IntegrationTest.connect_trust()

    setup = [
      "DROP TABLE IF EXISTS stale_plan_probe",
      "CREATE TABLE stale_plan_probe (a int)",
      "INSERT INTO stale_plan_probe (a) VALUES (1)"
    ]

    for sql in setup
      (next, outcome) = conn.query(sql)
      conn = next
      try IntegrationTest.unwrap(outcome)
    end

    (conn, first) = conn.execute("SELECT * FROM stale_plan_probe")
    try IntegrationTest.unwrap(first)

    # Adding a column changes the result shape of `SELECT *`, which
    # invalidates the cached plan (SQLSTATE 0A000) on the next run.
    (conn, altered) = conn.query(
      "ALTER TABLE stale_plan_probe ADD COLUMN b int",
    )
    try IntegrationTest.unwrap(altered)

    (conn, second) = conn.execute("SELECT * FROM stale_plan_probe")
    (conn, _) = conn.query("DROP TABLE stale_plan_probe")
    _ = conn.close()

    result = try IntegrationTest.unwrap(second)

    assert result.fields.length() == 2, "expected a re-prepare after the schema change"
  end

  test "a deallocated statement re-prepares"
    conn = try IntegrationTest.connect_trust()

    first_params = [Value.int(1)]
    (conn, first) = conn.execute("SELECT $1 AS n", first_params)
    try IntegrationTest.unwrap(first)

    # DEALLOCATE ALL drops every prepared statement server-side, like
    # a pooler running DISCARD ALL between checkouts.
    (conn, dropped) = conn.query("DEALLOCATE ALL")
    try IntegrationTest.unwrap(dropped)

    second_params = [Value.int(9)]
    (conn, second) = conn.execute("SELECT $1 AS n", second_params)
    (conn, names) = IntegrationTest.prepared_names(conn)
    _ = conn.close()

    result = try IntegrationTest.unwrap(second)

    assert IntegrationTest.cell(result, 0, 0) == Value.Int(9), "expected a re-prepare after DEALLOCATE ALL"

    listed = try IntegrationTest.unwrap(names)

    assert listed.rows.length() == 1
  end

  priv fn connect_and_select_user(config: Config, want_user: String)
    ! Test.Failure

    conn = try IntegrationTest.connect_config(config)

    (conn, outcome) = conn.query("SELECT current_user")
    _ = conn.close()

    result = try IntegrationTest.unwrap(outcome)

    assert IntegrationTest.cell(result, 0, 0) == Value.String(want_user)
  end

  priv fn connect_trust -> Connection ! Test.Failure
    try IntegrationTest.connect_config(
      Config.new(TEST_HOST, TEST_PORT, "koja_trust", TEST_DATABASE),
    )
  end

  priv fn connect_config(config: Config) -> Connection ! Test.Failure
    match Connection.connect(config)
      Result.Ok(conn) -> conn
      Result.Err(e) ->
        fail "connect failed (is docker compose up?): #{e.message()}"
    end
  end

  # Unwraps a driver outcome, failing the test with the error's message
  # instead of its `Debug` rendering.
  priv fn unwrap<T>(outcome: Result<T, Error>) -> T ! Test.Failure
    match outcome
      Result.Ok(value) -> value
      Result.Err(e) -> fail Test.Failure.Error(e.message())
    end
  end

  # The typed value at a row and column, or `Null` when out of range.
  priv fn cell(result: QueryResult, row: Int, column: Int) -> Value
    match result.rows.get(row)
      Option.Some(columns) ->
        match columns.get(column)
          Option.Some(value) -> value
          Option.None -> Value.Null
        end

      Option.None ->
        Value.Null
    end
  end

  # The statement names the server currently holds, for cache
  # assertions. Uses the simple protocol, which the cache ignores.
  priv fn prepared_names(conn: Connection)
    -> (Connection, Result<QueryResult, Error>)

    conn.query("SELECT name FROM pg_prepared_statements ORDER BY name")
  end

  priv fn expect_tag(outcome: Result<QueryResult, Error>, want: String)
    ! Test.Failure

    result = try IntegrationTest.unwrap(outcome)

    assert result.tag == want
  end
end
