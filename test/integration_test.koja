# Integration tests against a live Postgres server. Start it first:
#
# docker compose up -d
#
priv const TEST_DATABASE: String = "koja_test"
priv const TEST_HOST: String = "127.0.0.1"
priv const TEST_PORT: Int = 5434

alias Test.Failure
alias Test.require

test "connects with trust auth and runs SELECT"
  conn = try require(connect_trust())

  (conn, outcome) = conn.query("SELECT 1 AS one, 'two' AS two")
  _ = conn.close()

  result = try require(outcome)

  assert result.tag == "SELECT 1"
  assert result.fields.length() == 2
  assert cell(result, 0, 0) == Value.Int(1)
  assert cell(result, 0, 1) == Value.String("two")
end

test "returns NULL columns as None"
  conn = try require(connect_trust())

  (conn, outcome) = conn.query("SELECT NULL AS nothing")
  _ = conn.close()

  result = try require(outcome)

  assert cell(result, 0, 0) == Value.Null
end

test "decodes bool, int, float, text, and NULL to typed values"
  conn = try require(connect_trust())

  (conn, outcome) = conn.query("SELECT true, 42, 1.5::float8, 'hi', NULL")
  _ = conn.close()

  result = try require(outcome)

  expected: List<Value> = [
    Value.Bool(true), Value.Int(42), Value.Float(1.5), Value.String("hi"),
    Value.Null
  ]

  index = 0

  for want in expected
    assert cell(result, 0, index) == want, "column #{index}"
    index = index + 1
  end
end

test "runs DDL and DML with the right command tags"
  conn = try require(connect_trust())

  (conn, created) = conn.query(
    "CREATE TEMP TABLE driver_test (id INT, label TEXT)",
  )
  try expect_tag(created, "CREATE TABLE")

  (conn, inserted) = conn.query(
    "INSERT INTO driver_test VALUES (7, 'seven'), (8, NULL)",
  )
  try expect_tag(inserted, "INSERT 0 2")

  (conn, selected) = conn.query("SELECT label FROM driver_test ORDER BY id")
  _ = conn.close()

  result = try require(selected)

  assert result.rows.length() == 2
  assert cell(result, 0, 0) == Value.String("seven")
  assert cell(result, 1, 0) == Value.Null
end

test "surfaces server errors with severity and SQLSTATE"
  conn = try require(connect_trust())

  (conn, outcome) = conn.query("SELEC 1")
  _ = conn.close()

  match outcome
    Result.Ok(_) ->
      fail "expected a syntax error, got a result"

    Result.Err(Error.Server(server_error)) ->
      assert server_error.code == "42601"
      assert server_error.severity == "ERROR"

    Result.Err(e) ->
      fail "expected Error.Server, got: #{e.message()}"
  end
end

test "connects with a cleartext password"
  config = Config.new(TEST_HOST, TEST_PORT, "koja_password", TEST_DATABASE)
    .with_password("koja_password_secret")

  try connect_and_select_user(config, "koja_password")
end

test "connects with SCRAM-SHA-256"
  config = Config.new(TEST_HOST, TEST_PORT, "koja_scram", TEST_DATABASE)
    .with_password("koja_scram_secret")

  try connect_and_select_user(config, "koja_scram")
end

test "rejects a wrong SCRAM password"
  config = Config.new(TEST_HOST, TEST_PORT, "koja_scram", TEST_DATABASE)
    .with_password("wrong")

  match Connection.connect(config)
    Result.Ok(conn) ->
      _ = conn.close()
      fail "expected authentication to fail"

    Result.Err(Error.Server(server_error)) ->
      assert server_error.code == "28P01"

    Result.Err(e) ->
      fail "expected a server error, got: #{e.message()}"
  end
end

test "fails clearly when a password is needed but missing"
  config = Config.new(TEST_HOST, TEST_PORT, "koja_scram", TEST_DATABASE)

  match Connection.connect(config)
    Result.Ok(conn) ->
      _ = conn.close()
      fail "expected connect to fail without a password"

    Result.Err(Error.AuthenticationFailed(_)) ->
      ()

    Result.Err(e) ->
      fail "expected AuthenticationFailed, got: #{e.message()}"
  end
end

test "executes a typed parameterized SELECT without casts"
  conn = try require(connect_trust())

  # Declared parameter OIDs type $1 and $2 as int8, so the SQL
  # needs no ::int casts.
  params = [Value.int(40), Value.int(2)]
  (conn, outcome) = conn.execute("SELECT $1 + $2 AS total", params)
  _ = conn.close()

  result = try require(outcome)

  assert result.tag == "SELECT 1"
  assert cell(result, 0, 0) == Value.Int(42)
end

test "executes DML with NULL parameters and reads them back"
  conn = try require(connect_trust())

  (conn, created) = conn.execute(
    "CREATE TEMP TABLE exec_test (id INT, label TEXT)",
  )
  try expect_tag(created, "CREATE TABLE")

  insert_params = [Value.int(1), Value.null()]
  (conn, inserted) = conn.execute(
    "INSERT INTO exec_test VALUES ($1, $2)",
    insert_params,
  )
  try expect_tag(inserted, "INSERT 0 1")

  select_params = [Value.int(1)]
  (conn, selected) = conn.execute(
    "SELECT label FROM exec_test WHERE id = $1",
    select_params,
  )
  _ = conn.close()

  result = try require(selected)

  assert result.rows.length() == 1
  assert cell(result, 0, 0) == Value.Null
end

test "surfaces server errors from execute"
  conn = try require(connect_trust())

  (conn, outcome) = conn.execute("SELECT * FROM missing_table")
  _ = conn.close()

  match outcome
    Result.Ok(_) -> fail "expected an error for a missing table"
    Result.Err(Error.Server(server_error)) ->
      assert server_error.code == "42P01"
    Result.Err(e) -> fail "expected Error.Server, got: #{e.message()}"
  end
end

test "execute reuses a cached prepared statement"
  conn = try require(connect_trust())

  first_params = [Value.int(1)]
  (conn, first) = conn.execute("SELECT $1 AS n", first_params)
  try require(first)

  second_params = [Value.int(2)]
  (conn, second) = conn.execute("SELECT $1 AS n", second_params)
  result = try require(second)

  assert cell(result, 0, 0) == Value.Int(2), "from the cached statement"

  (conn, names) = prepared_names(conn)
  _ = conn.close()

  listed = try require(names)

  assert listed.rows.length() == 1
  assert cell(listed, 0, 0) == Value.String("koja_s1")
end

test "the cache evicts the least recently used statement"
  config = Config.new(TEST_HOST, TEST_PORT, "koja_trust", TEST_DATABASE)
    .with_statement_cache_size(1)

  conn = try require(connect_config(config))

  (conn, first) = conn.execute("SELECT 1 AS a")
  try require(first)

  (conn, second) = conn.execute("SELECT 2 AS b")
  try require(second)

  (conn, names) = prepared_names(conn)
  _ = conn.close()

  listed = try require(names)

  assert listed.rows.length() == 1, "the first statement should be closed"
  assert cell(listed, 0, 0) == Value.String("koja_s2")
end

test "a zero cache size prepares nothing"
  config = Config.new(TEST_HOST, TEST_PORT, "koja_trust", TEST_DATABASE)
    .with_statement_cache_size(0)

  conn = try require(connect_config(config))

  params = [Value.int(7)]
  (conn, outcome) = conn.execute("SELECT $1 AS n", params)
  result = try require(outcome)

  assert cell(result, 0, 0) == Value.Int(7), "from the uncached statement"

  (conn, names) = prepared_names(conn)
  _ = conn.close()

  listed = try require(names)

  assert listed.rows.length() == 0
end

test "a schema change under a cached statement re-prepares"
  conn = try require(connect_trust())

  setup = [
    "DROP TABLE IF EXISTS stale_plan_probe",
    "CREATE TABLE stale_plan_probe (a int)",
    "INSERT INTO stale_plan_probe (a) VALUES (1)"
  ]

  for sql in setup
    (next, outcome) = conn.query(sql)
    conn = next
    try require(outcome)
  end

  (conn, first) = conn.execute("SELECT * FROM stale_plan_probe")
  try require(first)

  # Adding a column changes the result shape of `SELECT *`, which
  # invalidates the cached plan (SQLSTATE 0A000) on the next run.
  (conn, altered) = conn.query("ALTER TABLE stale_plan_probe ADD COLUMN b int")
  try require(altered)

  (conn, second) = conn.execute("SELECT * FROM stale_plan_probe")
  (conn, _) = conn.query("DROP TABLE stale_plan_probe")
  _ = conn.close()

  result = try require(second)

  assert result.fields.length() == 2, "after re-prepare"
end

test "a deallocated statement re-prepares"
  conn = try require(connect_trust())

  first_params = [Value.int(1)]
  (conn, first) = conn.execute("SELECT $1 AS n", first_params)
  try require(first)

  # DEALLOCATE ALL drops every prepared statement server-side, like
  # a pooler running DISCARD ALL between checkouts.
  (conn, dropped) = conn.query("DEALLOCATE ALL")
  try require(dropped)

  second_params = [Value.int(9)]
  (conn, second) = conn.execute("SELECT $1 AS n", second_params)
  (conn, names) = prepared_names(conn)
  _ = conn.close()

  result = try require(second)
  assert cell(result, 0, 0) == Value.Int(9), "from the re-prepared statement"

  listed = try require(names)
  assert listed.rows.length() == 1
end

test "a server error keeps the connection open"
  conn = try require(connect_trust())

  (conn, outcome) = conn.query("SELECT 1/0")

  match outcome
    Result.Err(Error.Server(server_error)) ->
      assert server_error.code == "22012"
    Result.Ok(_) -> fail "expected a division by zero error"
    Result.Err(e) -> fail "expected Error.Server, got: #{e.message()}"
  end

  assert conn.open?(), "a server error must not close the connection"
  assert conn.idle?(), "expected idle after a server error outside a block"

  (conn, outcome) = conn.query("SELECT 1")
  _ = conn.close()

  result = try require(outcome)

  assert cell(result, 0, 0) == Value.Int(1), "from the follow-up query"
end

test "a server terminate closes the connection and later calls fail fast"
  conn = try require(connect_trust())

  (conn, outcome) = conn.query("SELECT pg_terminate_backend(pg_backend_pid())")
  try expect_closed(outcome, "terminate")

  assert not conn.open?(), "expected the connection to be closed after terminate"
  assert not conn.idle?(), "a closed connection is never idle"

  # Neither call touches the socket. Both report the closed state.
  (conn, outcome) = conn.query("SELECT 1")
  try expect_closed(outcome, "query on a closed connection")

  (conn, outcome) = conn.execute("SELECT $1 AS n", [Value.int(1)])
  try expect_closed(outcome, "execute on a closed connection")

  assert not conn.open?(), "expected the connection to stay closed"
end

test "transaction status follows the session"
  conn = try require(connect_trust())

  assert conn.idle?(), "expected idle after connect"

  (conn, _) = conn.query("BEGIN")

  assert conn.transaction_status == TransactionStatus.InBlock
  assert not conn.idle?(), "a connection inside a block is not idle"

  (conn, _) = conn.query("SELECT 1/0")

  assert conn.transaction_status == TransactionStatus.Failed
  assert conn.open?(), "a failed block must not close the connection"

  (conn, _) = conn.query("ROLLBACK")
  idle = conn.idle?()
  _ = conn.close()

  assert idle, "expected idle after ROLLBACK"
end

priv fn expect_closed(outcome: Result<QueryResult, Error>, context: String)
  ! Failure

  match outcome
    Result.Err(Error.ConnectionClosed) -> ()
    Result.Ok(_) -> fail "#{context}: expected ConnectionClosed, got a result"
    Result.Err(e) ->
      fail "#{context}: expected ConnectionClosed, got: #{e.message()}"
  end
end

priv fn connect_and_select_user(config: Config, want_user: String) ! Failure
  conn = try Test.require(connect_config(config))

  (conn, outcome) = conn.query("SELECT current_user")
  _ = conn.close()

  result = try Test.require(outcome)

  if cell(result, 0, 0) != Value.String(want_user)
    fail "expected current_user `#{want_user}`"
  end
end

priv fn connect_trust -> Result<Connection, String>
  connect_config(Config.new(TEST_HOST, TEST_PORT, "koja_trust", TEST_DATABASE))
end

priv fn connect_config(config: Config) -> Result<Connection, String>
  match Connection.connect(config)
    Result.Ok(conn) ->
      Result.Ok(conn)

    Result.Err(e) ->
      Result.Err("connect failed (is docker compose up?): #{e.message()}")
  end
end

# The typed value at a row and column, or `Null` when out of range.
priv fn cell(result: QueryResult, row: Int, column: Int) -> Value
  match result.rows.get(row)
    Option.Some(columns) ->
      match columns.get(column)
        Option.Some(value) -> value
        Option.None -> Value.Null
      end

    Option.None ->
      Value.Null
  end
end

# The statement names the server currently holds, for cache
# assertions. Uses the simple protocol, which the cache ignores.
priv fn prepared_names(conn: Connection)
  -> (Connection, Result<QueryResult, String>)

  (conn, outcome) = conn.query(
    "SELECT name FROM pg_prepared_statements ORDER BY name",
  )

  match outcome
    Result.Ok(result) -> (conn, Result.Ok(result))
    Result.Err(e) -> (conn, Result.Err(e.message()))
  end
end

priv fn expect_tag(outcome: Result<QueryResult, Error>, want: String) ! Failure
  result = try Test.require(outcome)

  if result.tag != want
    fail "expected tag `#{want}`, got `#{result.tag}`"
  end
end
