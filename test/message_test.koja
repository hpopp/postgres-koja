alias Test.Failure
alias Test.require

test "encode_startup frames the protocol version and parameters"
  encoded = Message.encode_startup("alice", "appdb")

  match encoded
    <<len::32, version::32, rest: Binary>> ->
      assert len == encoded.byte_size()
      assert version == 196608
      try check_cstrings(rest, ["user", "alice", "database", "appdb"], 0)

    _ ->
      fail "startup message shorter than its header"
  end
end

test "encode_query wraps the SQL in a Q frame"
  encoded = Message.encode_query("SELECT 1")

  match encoded
    <<tag::8, len::32, payload: Binary>> ->
      assert tag == 0x51
      assert len == payload.byte_size() + 4

      match Wire.take_cstring(payload)
        Option.Some((sql, _)) -> assert sql == "SELECT 1"
        Option.None -> fail "payload is not a NUL-terminated string"
      end

    _ ->
      fail "query message shorter than its header"
  end
end

test "TERMINATE is a bare X frame"
  assert TERMINATE == <<0x58, 4::32>>
end

test "decode recognizes ReadyForQuery"
  assert Message.decode(frame(90, <<73::8>>)) ==
    Backend.ReadyForQuery(TransactionStatus.Idle)
end

test "decode reads the ReadyForQuery transaction status byte"
  try expect_status(73, TransactionStatus.Idle)
  try expect_status(84, TransactionStatus.InBlock)
  try expect_status(69, TransactionStatus.Failed)
  # An unknown byte reads as idle rather than wedging the connection.
  try expect_status(63, TransactionStatus.Idle)
end

test "decode extracts the CommandComplete tag"
  decoded = Message.decode(frame(67, cstring("INSERT 0 1")))

  assert decoded == Backend.CommandComplete("INSERT 0 1")
end

test "decode collects severity, code, and message from ErrorResponse"
  body = <<
    83, cstring("ERROR"), 86, cstring("ERROR"), 67, cstring("42601"), 77,
    cstring("syntax error at or near \"SELEC\""), 0
  >>

  match Message.decode(frame(69, body))
    Backend.ErrorResponse(server_error) ->
      assert server_error.severity == "ERROR"
      assert server_error.code == "42601"
      assert server_error.message == "syntax error at or near \"SELEC\""

    _ ->
      fail "expected Backend.ErrorResponse"
  end
end

test "decode reads column names and type OIDs from RowDescription"
  body = <<
    2::16, cstring("id"), field_metadata(23), cstring("name"),
    field_metadata(25)
  >>

  match Message.decode(frame(84, body))
    Backend.RowDescription(fields) ->
      assert fields.length() == 2
      try expect_field(fields.get(0), "id", 23)
      try expect_field(fields.get(1), "name", 25)

    _ ->
      fail "expected Backend.RowDescription"
  end
end

test "decode reads text and NULL columns from DataRow"
  body = <<2::16, 5::32, "hello", 4294967295::32>>

  match Message.decode(frame(68, body))
    Backend.DataRow(columns) ->
      assert columns.length() == 2
      assert columns.get(0) == Option.Some(Option.Some("hello"))
      assert columns.get(1).unwrap().none?(), "expected second column to be NULL"

    _ ->
      fail "expected Backend.DataRow"
  end
end

test "encode_parse frames the unnamed statement with no types"
  no_oids: List<Int> = []
  encoded = Message.encode_parse("", "SELECT $1", no_oids)

  match encoded
    <<tag::8, len::32, body: Binary>> ->
      assert tag == 0x50
      assert len == body.byte_size() + 4

      # Body: empty statement name, the SQL text, then zero
      # pre-declared parameter types.
      (name, rest) = try require(
        Wire.take_cstring(body).or_err("missing statement name"),
      )
      assert name == ""

      (sql, rest) = try require(
        Wire.take_cstring(rest).or_err("missing SQL text"),
      )
      assert sql == "SELECT $1"
      assert rest == <<0::16>>

    _ ->
      fail "parse message shorter than its header"
  end
end

test "encode_parse declares a name and parameter type OIDs"
  oids: List<Int> = [20, 16]
  encoded = Message.encode_parse("s1", "SELECT $1, $2", oids)

  match encoded
    <<0x50, _len::32, body: Binary>> ->
      (name, rest) = try require(
        Wire.take_cstring(body).or_err("missing statement name"),
      )
      assert name == "s1"

      (_, rest) = try require(
        Wire.take_cstring(rest).or_err("missing SQL text"),
      )
      assert rest == <<2::16, 20::32, 16::32>>

    _ ->
      fail "parse message shorter than its header"
  end
end

test "encode_bind carries text and NULL parameters"
  params: List<Option<String>> = [Option.Some("42"), Option.None]
  encoded = Message.encode_bind("", params)

  match encoded
    <<tag::8, len::32, body: Binary>> ->
      assert tag == 0x42
      assert len == body.byte_size() + 4

      # Body: portal "", statement "", 0 format codes, 2 params:
      # int32 2 + "42", int32 -1 (NULL), then 0 result formats.
      assert body ==
        <<0, 0, 0::16, 2::16, 2::32, 52, 50, 4294967295::32, 0::16>>

    _ ->
      fail "bind message shorter than its header"
  end
end

test "encode_bind names the statement it binds"
  no_params: List<Option<String>> = []
  encoded = Message.encode_bind("s7", no_params)

  match encoded
    <<0x42, _len::32, body: Binary>> ->
      # Body: portal "", statement "s7", 0 format codes, 0 params,
      # 0 result formats.
      assert body == <<0, 115, 55, 0, 0::16, 0::16, 0::16>>

    _ ->
      fail "bind message shorter than its header"
  end
end

test "encode_close frames a statement Close"
  assert Message.encode_close("s3") == <<0x43, 8::32, 0x53, 115, 51, 0>>
end

test "DESCRIBE_PORTAL, EXECUTE, and SYNC frame correctly"
  assert DESCRIBE_PORTAL == <<0x44, 6::32, 0x50, 0>>
  assert EXECUTE == <<0x45, 9::32, 0, 0::32>>
  assert SYNC == <<0x53, 4::32>>
end

test "decode recognizes the extended-protocol responses"
  assert Message.decode(frame(49, <<>>)) == Backend.ParseComplete
  assert Message.decode(frame(50, <<>>)) == Backend.BindComplete
  assert Message.decode(frame(73, <<>>)) == Backend.EmptyQueryResponse
  assert Message.decode(frame(110, <<>>)) == Backend.NoData
  assert Message.decode(frame(115, <<>>)) == Backend.PortalSuspended
  assert Message.decode(frame(116, <<2::16, 0::32, 0::32>>)) ==
    Backend.ParameterDescription
end

test "decode maps unknown tags to Other"
  assert Message.decode(frame(33, <<>>)) == Backend.Other
end

priv fn frame(tag: Int, body: Binary) -> Binary
  <<tag, (body.byte_size() + 4)::32, body>>
end

priv fn cstring(s: String) -> Binary
  <<s.to_binary(), 0>>
end

# The 18 bytes of per-field metadata (table oid, attribute number,
# type oid, type size, type modifier, format code) that follow each
# name in a RowDescription.
priv fn field_metadata(type_oid: Int) -> Binary
  <<0::32, 0::16, type_oid::32, 0::16, 0::32, 0::16>>
end

# Checks that `data` is exactly `expected` as NUL-terminated strings
# from `index` on, followed by the final terminator.
priv fn check_cstrings(data: Binary, expected: List<String>, index: Int)
  ! Failure

  match expected.get(index)
    Option.None ->
      assert data == <<0>>, "startup params missing final terminator"

    Option.Some(want) ->
      (actual, rest) = try require(
        Wire.take_cstring(data).or_err("startup params ended before `#{want}`"),
      )
      assert actual == want
      try check_cstrings(rest, expected, index + 1)
  end
end

priv fn expect_status(byte: Int, want: TransactionStatus) ! Failure
  match Message.decode(frame(90, <<byte::8>>))
    Backend.ReadyForQuery(got) -> assert got == want, "status byte #{byte}"
    _ -> fail "expected Backend.ReadyForQuery for byte #{byte}"
  end
end

priv fn expect_field(actual: Option<Field>, want: String, want_oid: Int)
  ! Failure

  match actual
    Option.Some(field) ->
      assert field.name == want
      assert field.type_oid == want_oid, "OID for `#{want}`"

    Option.None ->
      fail "expected `#{want}`, got None"
  end
end
