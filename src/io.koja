alias Net.Socket.Error as SocketError
alias Net.TCPSocket
alias Net.TLSError

# Socket framing and binary cursor helpers for the driver.
#
# Postgres speaks a binary wire protocol whose length-prefix bytes
# routinely land in the 0x80-0xFF range, so the driver stays in
# `Binary` end to end. Reads go through `TCPSocket.read_binary` and
# writes through `TCPSocket.write`, both on the I/O reactor. When the
# non-blocking socket would block, the calling process suspends
# cooperatively until the fd is ready, then retries.
priv struct Wire
  # Writes every byte of `data` to the socket, and loops until the
  # whole buffer is out. Returns the number of bytes written.
  fn write_all(socket: TCPSocket, data: Binary) -> Int ! Error
    try write_from(socket, data, 0)
  end

  # Reads one complete backend message from `socket`. `buffer` carries
  # bytes already read past the previous message. Returns the framed
  # message (type byte + length prefix + body) paired with the leftover
  # bytes to feed into the next read.
  fn read_message(socket: TCPSocket, buffer: Binary) -> (Binary, Binary) ! Error
    buffer = try fill(socket, buffer, 5)

    body_len =
      match buffer
        <<_type::8, len::32, _rest: Binary>> -> len
        _ -> fail Error.Protocol("short message header")
      end

    total = body_len + 1
    buffer = try fill(socket, buffer, total)
    split_at(buffer, total)
  end

  # Splits `data` into the first `n` bytes and the remainder, and
  # clamps `n` to the available length.
  fn split_at(data: Binary, n: Int) -> (Binary, Binary)
    size = data.byte_size()
    head_len = n > size ? size : n
    head = CPtr.borrow(data).to_binary(head_len)
    tail = CPtr.borrow(data).offset(head_len).to_binary(size - head_len)
    (head, tail)
  end

  # Pulls a big-endian unsigned 16-bit integer off the front of `data`
  # and returns it with the remaining bytes.
  fn take_u16(data: Binary) -> Option<(Int, Binary)>
    match data
      <<n::16, rest: Binary>> -> Option.Some((n, rest))
      _ -> Option.None
    end
  end

  # Pulls a big-endian unsigned 32-bit integer off the front of `data`
  # and returns it with the remaining bytes.
  fn take_u32(data: Binary) -> Option<(Int, Binary)>
    match data
      <<n::32, rest: Binary>> -> Option.Some((n, rest))
      _ -> Option.None
    end
  end

  # Reads a NUL-terminated string off the front of `data` and returns
  # the decoded text with the bytes after the terminator.
  fn take_cstring(data: Binary) -> Option<(String, Binary)>
    scan_cstring(data, <<>>)
  end

  # Returns the byte at `index`, or 0 when `index` is out of bounds.
  fn byte_at(data: Binary, index: Int) -> Int
    match data.at(index)
      Option.Some(b) -> b
      Option.None -> 0
    end
  end

  priv fn scan_cstring(data: Binary, acc: Binary) -> Option<(String, Binary)>
    match data
      <<0, rest: Binary>> ->
        match acc.to_string()
          Result.Ok(s) -> Option.Some((s, rest))
          Result.Err(_) -> Option.None
        end

      <<b::8, rest: Binary>> ->
        scan_cstring(rest, <<acc, b>>)

      _ ->
        Option.None
    end
  end

  priv fn fill(socket: TCPSocket, buffer: Binary, needed: Int) -> Binary ! Error
    if buffer.byte_size() >= needed
      return buffer
    end

    chunk = socket.read_binary(8192) rescue e -> fail Error.IO(net_message(e))

    if chunk.byte_size() == 0
      fail Error.ConnectionClosed
    end

    try fill(socket, buffer <> chunk, needed)
  end

  priv fn write_from(socket: TCPSocket, data: Binary, offset: Int)
    -> Int ! Error

    (_, remaining) = split_at(data, offset)

    if remaining.byte_size() == 0
      return offset
    end

    written = socket.write(remaining) rescue e -> fail Error.IO(net_message(e))

    try write_from(socket, data, offset + written)
  end

  priv fn net_message(e: SocketError | TLSError) -> String
    match e
      socket_error: SocketError -> socket_error.message()
      tls_error: TLSError -> tls_error.message()
    end
  end
end
