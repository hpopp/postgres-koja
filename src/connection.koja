alias Net.TCPSocket

@doc """
A live Postgres connection that speaks the v3 wire protocol.

The connection owns its TCP socket and a read buffer that carries any
bytes read past the last consumed message. Koja values are
independent, so `query` returns an updated connection alongside its
result. Rebind to the returned connection.
"""
struct Connection
  buffer: Binary
  socket: TCPSocket

  @doc """
  Opens a connection and performs the startup handshake (trust,
  cleartext password, or SCRAM-SHA-256 as the server demands). Waits
  until the server reports it is ready for queries.
  """
  fn connect(config: Config) -> Connection ! Error
    socket = TCPSocket.connect(config.host, config.port)
      rescue e -> fail Error.ConnectFailed(e.message())

    startup = Message.encode_startup(config.user, config.database)
    try Wire.write_all(socket, startup)

    buffer: Binary = <<>>
    leftover = try handshake(socket, buffer, config)
    Connection{buffer: leftover, socket: socket}
  end

  @doc """
  Runs a single SQL statement and collects its result set. Returns the
  updated connection paired with the query outcome.
  """
  fn query(self, sql: String) -> (Connection, Result<QueryResult, Error>)
    match Wire.write_all(self.socket, Message.encode_query(sql))
      Result.Err(e) -> return (self, Result.Err(e))
      Result.Ok(_) -> ()
    end

    (buffer, outcome) = collect(self.socket, self.buffer, QueryState.empty())
    (Connection{buffer: buffer, socket: self.socket}, outcome)
  end

  @doc """
  Runs a single SQL statement with `$1`-style parameters via the
  extended query protocol. Parameters are text-format, and
  `Option.None` binds SQL NULL. Returns the updated connection
  paired with the query outcome.
  """
  fn execute(self, sql: String, params: List<Option<String>>)
    -> (Connection, Result<QueryResult, Error>)

    payload = Message.encode_parse(sql) <> Message.encode_bind(params) <>
      DESCRIBE_PORTAL <> EXECUTE <> SYNC

    match Wire.write_all(self.socket, payload)
      Result.Err(e) -> return (self, Result.Err(e))
      Result.Ok(_) -> ()
    end

    (buffer, outcome) = collect(self.socket, self.buffer, QueryState.empty())
    (Connection{buffer: buffer, socket: self.socket}, outcome)
  end

  @doc """
  Sends a Terminate message (best effort) and closes the socket.
  """
  fn close(self) ! Error
    _ = Wire.write_all(self.socket, TERMINATE)
    self.socket.close() rescue e -> fail Error.IO(e.message())
  end

  # Pumps startup-phase messages until the server reports
  # ReadyForQuery, and answers authentication requests along the way.
  priv fn handshake(socket: TCPSocket, buffer: Binary, config: Config)
    -> Binary ! Error

    (message, leftover) = try Wire.read_message(socket, buffer)

    match Message.decode(message)
      Backend.ReadyForQuery ->
        leftover

      Backend.ErrorResponse(server_error) ->
        fail Error.Server(server_error)

      Backend.AuthenticationCleartextPassword ->
        password = try require_password(config)
        try Wire.write_all(socket, Message.encode_password(password))
        try handshake(socket, leftover, config)

      Backend.AuthenticationSASL(mechanisms) ->
        leftover = try sasl_authenticate(socket, leftover, config, mechanisms)
        try handshake(socket, leftover, config)

      Backend.AuthenticationOther(kind) ->
        fail Error.UnsupportedAuthentication(auth_method_name(kind))

      _ ->
        try handshake(socket, leftover, config)
    end
  end

  # Runs the SCRAM-SHA-256 exchange: client-first, server-first,
  # client-final, server-final (verified). Returns the unconsumed
  # read buffer. The AuthenticationOk and ReadyForQuery messages
  # that follow stay in the buffer for `handshake`.
  priv fn sasl_authenticate(
    socket: TCPSocket,
    buffer: Binary,
    config: Config,
    mechanisms: List<String>,
  ) -> Binary ! Error

    unless mechanisms.any?(m -> m == "SCRAM-SHA-256")
      fail Error.UnsupportedAuthentication("server offered no supported SASL mechanism")
    end

    password = try require_password(config)

    nonce = Scram.generate_nonce()
    initial = Message.encode_sasl_initial(
      "SCRAM-SHA-256",
      Scram.first_message("", nonce),
    )

    try Wire.write_all(socket, initial)

    (continue_message, continue_buffer) = try read_auth_message(socket, buffer)

    server_first =
      match continue_message
        Backend.AuthenticationSASLContinue(text) -> text
        Backend.ErrorResponse(server_error) -> fail Error.Server(server_error)
        _ -> fail Error.Protocol("expected SASL continue message")
      end

    proof = Scram.proof(password, "", nonce, server_first)
      rescue e -> fail Error.AuthenticationFailed(e)

    try Wire.write_all(socket, Message.encode_sasl_response(proof.client_final))

    (final_message, final_buffer) = try read_auth_message(
      socket,
      continue_buffer,
    )

    server_final =
      match final_message
        Backend.AuthenticationSASLFinal(text) -> text
        Backend.ErrorResponse(server_error) -> fail Error.Server(server_error)
        _ -> fail Error.Protocol("expected SASL final message")
      end

    Scram.verify_server_final(server_final, proof.server_signature)
      rescue e -> fail Error.AuthenticationFailed(e)

    final_buffer
  end

  # Reads and decodes one message during the SASL exchange.
  priv fn read_auth_message(socket: TCPSocket, buffer: Binary)
    -> (Backend, Binary) ! Error

    (message, leftover) = try Wire.read_message(socket, buffer)
    (Message.decode(message), leftover)
  end

  priv fn require_password(config: Config) -> String ! Error
    try config.password.or_err(
      Error.AuthenticationFailed("server requested a password but none was configured"),
    )
  end

  priv fn collect(socket: TCPSocket, buffer: Binary, state: QueryState)
    -> (Binary, Result<QueryResult, Error>)

    (message, leftover) =
      match Wire.read_message(socket, buffer)
        Result.Ok(p) -> p
        Result.Err(e) -> return (buffer, Result.Err(e))
      end

    match Message.decode(message)
      Backend.ReadyForQuery ->
        (leftover, state.finish())

      Backend.RowDescription(fields) ->
        collect(socket, leftover, state.with_fields(fields))

      Backend.DataRow(columns) ->
        collect(socket, leftover, state.add_row(columns))

      Backend.CommandComplete(tag) ->
        collect(socket, leftover, state.with_tag(tag))

      Backend.ErrorResponse(server_error) ->
        collect(socket, leftover, state.with_error(server_error))

      _ ->
        collect(socket, leftover, state)
    end
  end

  priv fn auth_method_name(kind: Int) -> String
    match kind
      3 -> "cleartext password"
      5 -> "md5"
      10 -> "sasl"
      _ -> "authentication code #{kind}"
    end
  end
end

@doc """
The result of a successful query: column names, the rows (each a list
of nullable text values), and the command tag (e.g. "INSERT 0 1").
"""
struct QueryResult
  fields: List<String>
  rows: List<List<Option<String>>>
  tag: String
end

# Accumulator threaded through the read loop that consumes a query's
# response stream.
priv struct QueryState
  error: Option<ServerError>
  fields: List<String>
  rows: List<List<Option<String>>>
  tag: String

  fn empty -> QueryState
    fields: List<String> = List.new()
    rows: List<List<Option<String>>> = List.new()
    QueryState{error: Option.None, fields: fields, rows: rows, tag: ""}
  end

  fn add_row(self, columns: List<Option<String>>) -> QueryState
    self.rows = self.rows.append(columns)
    self
  end

  fn with_error(self, server_error: ServerError) -> QueryState
    self.error = Option.Some(server_error)
    self
  end

  fn with_fields(self, fields: List<String>) -> QueryState
    self.fields = fields
    self
  end

  fn with_tag(self, tag: String) -> QueryState
    self.tag = tag
    self
  end

  fn finish(self) -> Result<QueryResult, Error>
    match self.error
      Option.Some(server_error) ->
        Result.Err(Error.Server(server_error))

      Option.None ->
        Result.Ok(QueryResult{
          fields: self.fields,
          rows: self.rows,
          tag: self.tag,
        })
    end
  end
end
