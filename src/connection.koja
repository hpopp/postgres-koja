alias Net.TCPSocket

@doc """
A live Postgres connection that speaks the v3 wire protocol.

The connection owns its TCP socket and a read buffer that carries any
bytes read past the last consumed message. Koja values are
independent, so `query` returns an updated connection alongside its
result. Rebind to the returned connection.

`execute` caches prepared statements on the connection, keyed by SQL
text and parameter types, up to `Config.statement_cache_size` entries
with least-recently-used eviction. A repeated statement skips the
server parse and plan step.
"""
struct Connection
  buffer: Binary
  cache: StatementCache
  socket: TCPSocket

  @doc """
  Opens a connection and performs the startup handshake (trust,
  cleartext password, or SCRAM-SHA-256 as the server demands). Waits
  until the server reports it is ready for queries.
  """
  fn connect(config: Config) -> Connection ! Error
    socket = TCPSocket.connect(config.host, config.port)
      rescue e -> fail Error.ConnectFailed(e.message())

    leftover = try Startup.negotiate(socket, config)

    Connection{
      buffer: leftover,
      cache: StatementCache.new(config.statement_cache_size),
      socket: socket,
    }
  end

  @doc """
  Runs a single SQL statement and collects its result set. Returns the
  updated connection paired with the query outcome.
  """
  fn query(self, sql: String) -> (Connection, Result<QueryResult, Error>)
    self.run(Message.encode_query(sql))
  end

  @doc """
  Runs a single SQL statement with `$1`-style parameters via the
  extended query protocol. Parameters are typed `Value`s, and
  `Value.Null` binds SQL NULL. `params` defaults to none. Repeated
  statements reuse the connection's prepared statement cache. Returns
  the updated connection paired with the query outcome.
  """
  fn execute(self, sql: String, params: List<Value> = [])
    -> (Connection, Result<QueryResult, Error>)

    texts = params.map(fn (p: Value) -> Option<String> p.encode() end)
    oids = params.map(fn (p: Value) -> Int p.type_oid() end)

    unless self.cache.enabled?()
      payload = Message.encode_parse("", sql, oids) <>
        Message.encode_bind("", texts) <> DESCRIBE_PORTAL <> EXECUTE <> SYNC

      return self.run(payload)
    end

    key = StatementCache.key(sql, oids)
    (cache, cached) = self.cache.hit(key)
    self.cache = cache

    match cached
      Option.Some(name) ->
        (conn, outcome) = self.run(
          Message.encode_bind(name, texts) <> DESCRIBE_PORTAL <> EXECUTE <> SYNC,
        )

        match outcome
          Result.Err(e) ->
            unless stale_statement?(e)
              return (conn, outcome)
            end

            # The cached statement can no longer run (schema change or
            # the server dropped it). Both errors fire at Bind, before
            # execution, so one retry with a fresh statement is safe.
            conn.cache = conn.cache.remove(key)
            conn.prepare_and_run(
              key,
              sql,
              oids,
              texts,
              Message.encode_close(name),
            )

          Result.Ok(_) ->
            (conn, outcome)
        end

      Option.None ->
        empty: Binary = <<>>
        self.prepare_and_run(key, sql, oids, texts, empty)
    end
  end

  @doc """
  Sends a Terminate message (best effort) and closes the socket.
  """
  fn close(self) ! Error
    _ = Wire.write_all(self.socket, TERMINATE)
    self.socket.close() rescue e -> fail Error.IO(e.message())
  end

  # Writes one payload and collects the response stream into a result.
  priv fn run(self, payload: Binary) -> (Connection, Result<QueryResult, Error>)
    match Wire.write_all(self.socket, payload)
      Result.Err(e) -> return (self, Result.Err(e))
      Result.Ok(_) -> ()
    end

    (buffer, outcome) = collect(self.socket, self.buffer, QueryState.empty())
    self.buffer = buffer
    (self, outcome)
  end

  # Prepares a fresh named statement for `key`, runs it, and caches
  # the name on success. `stale_close` carries a Close frame for a
  # stale statement being replaced, or an empty binary.
  priv fn prepare_and_run(
    self,
    key: String,
    sql: String,
    oids: List<Int>,
    texts: List<Option<String>>,
    stale_close: Binary,
  ) -> (Connection, Result<QueryResult, Error>)

    (cache, name, close_frame) = self.cache.reserve()
    self.cache = cache

    payload = stale_close <> close_frame <>
      Message.encode_parse(name, sql, oids) <>
      Message.encode_bind(name, texts) <> DESCRIBE_PORTAL <> EXECUTE <> SYNC

    (conn, outcome) = self.run(payload)

    match outcome
      Result.Ok(_) ->
        conn.cache = conn.cache.store(key, name)
        (conn, outcome)

      Result.Err(_) ->
        (conn, outcome)
    end
  end

  priv fn collect(socket: TCPSocket, buffer: Binary, state: QueryState)
    -> (Binary, Result<QueryResult, Error>)

    (message, leftover) =
      match Wire.read_message(socket, buffer)
        Result.Ok(p) -> p
        Result.Err(e) -> return (buffer, Result.Err(e))
      end

    match Message.decode(message)
      Backend.ReadyForQuery ->
        (leftover, state.finish())

      Backend.RowDescription(fields) ->
        collect(socket, leftover, state.with_fields(fields))

      Backend.DataRow(columns) ->
        collect(socket, leftover, state.add_row(columns))

      Backend.CommandComplete(tag) ->
        collect(socket, leftover, state.with_tag(tag))

      Backend.ErrorResponse(server_error) ->
        collect(socket, leftover, state.with_error(server_error))

      _ ->
        collect(socket, leftover, state)
    end
  end

  priv fn auth_method_name(kind: Int) -> String
    match kind
      3 -> "cleartext password"
      5 -> "md5"
      10 -> "sasl"
      _ -> "authentication code #{kind}"
    end
  end
end

@doc """
The result of a successful query: column names, the rows (each a list
of typed `Value`s decoded against the server's column types), and the
command tag (e.g. "INSERT 0 1").
"""
struct QueryResult
  fields: List<String>
  rows: List<List<Value>>
  tag: String
end

# Accumulator threaded through the read loop that consumes a query's
# response stream. Rows decode against the RowDescription type OIDs
# as they arrive.
priv struct QueryState
  error: Option<ServerError>
  fields: List<Field>
  rows: List<List<Value>>
  tag: String

  fn empty -> QueryState
    fields: List<Field> = List.new()
    rows: List<List<Value>> = List.new()
    QueryState{error: Option.None, fields: fields, rows: rows, tag: ""}
  end

  fn add_row(self, columns: List<Option<String>>) -> QueryState
    row: List<Value> = List.new()
    index = 0

    for column in columns
      row = row.append(Value.decode(self.oid_at(index), column))
      index = index + 1
    end

    self.rows = self.rows.append(row)
    self
  end

  fn with_error(self, server_error: ServerError) -> QueryState
    self.error = Option.Some(server_error)
    self
  end

  fn with_fields(self, fields: List<Field>) -> QueryState
    self.fields = fields
    self
  end

  fn with_tag(self, tag: String) -> QueryState
    self.tag = tag
    self
  end

  fn finish(self) -> Result<QueryResult, Error>
    match self.error
      Option.Some(server_error) ->
        Result.Err(Error.Server(server_error))

      Option.None ->
        Result.Ok(QueryResult{
          fields: self.fields.map(fn (f: Field) -> String f.name end),
          rows: self.rows,
          tag: self.tag,
        })
    end
  end

  # The type OID for a column position, or 0 (unknown) when the row
  # is wider than its description.
  priv fn oid_at(self, index: Int) -> Int
    match self.fields.get(index)
      Option.Some(field) -> field.type_oid
      Option.None -> 0
    end
  end
end
