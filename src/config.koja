@doc """
Connection settings for `Connection.connect`.

`statement_cache_size` caps the per-connection prepared statement
cache that `Connection.execute` maintains. Set 0 to prepare every
statement as unnamed and cache nothing.
"""
struct Config
  database: String
  host: String
  password: Option<String> = Option.None
  port: Int = 5432
  statement_cache_size: Int = 256
  user: String

  @doc """
  Builds a config with no password, for servers that use trust
  authentication. If the server requires a password, chain
  `with_password`.
  """
  fn new(host: String, port: Int, user: String, database: String) -> Config
    Config{database: database, host: host, port: port, user: user}
  end

  @doc """
  Returns the config with the given password set.
  """
  fn with_password(self, password: String) -> Config
    self.password = Option.Some(password)
    self
  end

  @doc """
  Returns the config with the given statement cache size. Set 0 to
  turn the cache off.
  """
  fn with_statement_cache_size(self, size: Int) -> Config
    self.statement_cache_size = size
    self
  end
end
