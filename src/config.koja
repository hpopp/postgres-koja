@doc """
Connection settings for `Connection.connect`.
"""
struct Config
  database: String
  host: String
  password: Option<String>
  port: Int
  user: String

  @doc """
  Builds a config with no password, for servers that use trust
  authentication. If the server requires a password, chain
  `with_password`.
  """
  fn new(host: String, port: Int, user: String, database: String) -> Config
    Config{
      database: database,
      host: host,
      password: Option.None,
      port: port,
      user: user,
    }
  end

  @doc """
  Returns the config with the given password set.
  """
  fn with_password(self, password: String) -> Config
    self.password = Option.Some(password)
    self
  end
end
