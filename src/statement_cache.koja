# The per-connection prepared statement cache behind
# `Connection.execute`. Public only because `Connection.cache` names
# it. Not for callers to construct or change.
#
# Entries map a cache key, the SQL text plus the parameter type OIDs,
# to a server-side statement name, with least-recently-used eviction
# bounded by `limit`. Values are immutable. Every operation returns
# the updated cache, and the connection rebinds it.
@doc false
struct StatementCache
  counter: Int
  entries: Map<String, (String, Int)>
  limit: Int
  tick: Int

  # SQLSTATE `feature_not_supported`. The server sends it when a
  # cached plan is invalid after a schema change.
  priv const FEATURE_NOT_SUPPORTED: String = "0A000"
  # SQLSTATE `invalid_sql_statement_name`. The statement no longer
  # exists on the server, for example after a pooler ran DISCARD ALL.
  priv const INVALID_SQL_STATEMENT_NAME: String = "26000"

  @doc """
  Build an empty cache that holds at most `limit` statements. A limit
  of 0 turns the cache off.
  """
  fn new(limit: Int) -> StatementCache
    entries: Map<String, (String, Int)> = Map.new()
    StatementCache{counter: 0, entries: entries, limit: limit, tick: 0}
  end

  @doc """
  Report whether the cache stores statements.
  """
  fn enabled?(self) -> Bool
    self.limit > 0
  end

  @doc """
  Build the cache key for a statement from the SQL text and the
  declared parameter type OIDs. The same SQL with different parameter
  types is a different server-side statement.
  """
  fn key(sql: String, oids: List<Int>) -> String
    key = sql

    for oid in oids
      key = key <> "|#{oid}"
    end

    key
  end

  @doc """
  Look up the statement name for `key` and mark it just used.
  Return the updated cache and the name, or `None` on a miss.
  """
  fn hit(self, key: String) -> (StatementCache, Option<String>)
    match self.entries.get(key)
      Option.Some(stored) ->
        (name, _) = stored
        (self.touch(key, name), Option.Some(name))

      Option.None ->
        miss: Option<String> = Option.None
        (self, miss)
    end
  end

  @doc """
  Claim a fresh statement name. When the cache is full, evict the
  least recently used entry first. Return the updated cache, the
  name, and a Close frame for the evicted statement. The frame is
  empty when nothing was evicted. Record the name with `store` once
  the statement parses.
  """
  fn reserve(self) -> (StatementCache, String, Binary)
    (cache, close_frame) = self.evict_if_full()
    cache.counter = cache.counter + 1
    (cache, "koja_s#{cache.counter}", close_frame)
  end

  @doc """
  Record `name` as the prepared statement for `key` and mark it just
  used.
  """
  fn store(self, key: String, name: String) -> StatementCache
    self.touch(key, name)
  end

  @doc """
  Remove the entry for `key`, if one exists.
  """
  fn remove(self, key: String) -> StatementCache
    self.entries = self.entries.remove(key)
    self
  end

  priv fn touch(self, key: String, name: String) -> StatementCache
    self.tick = self.tick + 1
    self.entries = self.entries.put(key, (name, self.tick))
    self
  end

  # Removes the least recently used entry when the cache is full.
  # Returns the updated cache and a Close frame to send ahead of the
  # next Parse, or an empty binary when nothing was evicted.
  priv fn evict_if_full(self) -> (StatementCache, Binary)
    if self.entries.length() < self.limit
      empty: Binary = <<>>
      return (self, empty)
    end

    victim_key = ""
    victim_name = ""
    oldest = -1

    for entry in self.entries
      (entry_key, stored) = entry
      (name, tick) = stored

      if oldest < 0 or tick < oldest
        oldest = tick
        victim_key = entry_key
        victim_name = name
      end
    end

    self.entries = self.entries.remove(victim_key)
    (self, Message.encode_close(victim_name))
  end
end

# True when the server reports a cached statement is unusable. The
# cached plan is invalid after a schema change, or the statement no
# longer exists on the server.
priv fn stale_statement?(error: Error) -> Bool
  match error
    Error.Server(server_error) ->
      server_error.code == StatementCache.FEATURE_NOT_SUPPORTED
        or server_error.code == StatementCache.INVALID_SQL_STATEMENT_NAME

    _ ->
      false
  end
end
